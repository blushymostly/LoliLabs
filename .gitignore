# Publish only the public mod sources and Gradle project.
/*
!/.gitattributes
!/.gitignore
!/build.gradle
!/changelog.md
!/gradle.properties
!/gradlew
!/gradlew.bat
!/settings.gradle
!/gradle/
!/gradle/**
!/src/
!/src/**
!/resources/
!/resources/**
!/run/
/run/*
!/run/kubejs/
!/run/kubejs/**

# Local / generated noise that may appear under allowed trees
**/.gradle/
**/build/
**/dist/
**/*.class
**/*.jar
**/*.log
**/*.tmp
**/*.bak
**/.DS_Store
**/Thumbs.db
**/recipe-editor/.cache/
**/recipe-editor/backups/
.env
.env.*
*.pem
*.pfx
*.key

# Wrapper binary must remain trackable
!gradle/wrapper/gradle-wrapper.jar